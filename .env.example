# Copiá este archivo a .env.local y completá los valores.
# Las variables VITE_* quedan dentro del sitio público: nunca pongas acá la service_role key.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Título que se muestra en la app y en la pestaña del navegador
VITE_APP_TITLE=Habilitaciones de amoladoras

# --- Solo para scripts/crear-admin.mjs (se corre en tu PC, no se sube a Cloudflare) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
