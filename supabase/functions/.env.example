# Secretos de la Edge Function avisos-vencimiento.
# Cargalos con: npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase solo).

# Secreto compartido con pg_cron (generalo con: openssl rand -hex 32)
CRON_SECRET=

# A quién llega el resumen diario (se pueden poner varias separadas por coma)
ALERT_EMAIL=seguridad@empresa.com
# Dirección de la app, para los links del mail
APP_URL=https://habilitaciones-amoladoras.pages.dev
APP_TITLE=Habilitaciones de amoladoras

# Remitente. Con Resend tiene que ser de un dominio verificado; con Gmail, tu cuenta.
EMAIL_FROM=Avisos <avisos@tudominio.com>

# Opción A: Resend (https://resend.com)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Si otra app del mismo proyecto ya usa RESEND_API_KEY con otra cuenta, poné la de esta app acá
# (tiene prioridad) y dejá RESEND_API_KEY como está.
# HABILITACIONES_RESEND_API_KEY=

# Opción B: Gmail por SMTP con contraseña de aplicación
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=la-contraseña-de-aplicación-de-16-letras
